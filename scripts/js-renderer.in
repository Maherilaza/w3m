#!/bin/sh
# js-renderer: dump the fully rendered DOM of a URL to stdout.
#
# Intended as the command for the "js_renderer" siteconf/rc option:
#
#   url m@^https?://(www\.)?example\.com/@
#   js_renderer "js-renderer %s"
#
# Press X (JS_RELOAD) on the page to swap in the rendered version.
# Requires a Chromium-based browser: either one installed by Playwright
# (npx playwright install chromium) or chromium/google-chrome in PATH.
# --no-sandbox is needed when running as root or in containers;
# --virtual-time-budget lets single-page apps finish client-side
# rendering before the DOM is dumped.

BIN=$(ls -d "$HOME"/.cache/ms-playwright/chromium_headless_shell-*/chrome-headless-shell-linux*/chrome-headless-shell 2>/dev/null | head -1)
if [ -z "$BIN" ]; then
    for b in chromium chromium-browser google-chrome google-chrome-stable; do
	if command -v "$b" >/dev/null 2>&1; then
	    BIN=$b
	    break
	fi
    done
fi
if [ -z "$BIN" ]; then
    echo "js-renderer: no Chromium-based browser found" >&2
    exit 1
fi
exec timeout 60 "$BIN" --headless --no-sandbox --disable-gpu \
    --virtual-time-budget=15000 --dump-dom "$1" 2>/dev/null
